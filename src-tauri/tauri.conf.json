{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigiPot Studio",
  "version": "0.1.1",
  "identifier": "com.digipotstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DigiPot Studio — MCP4161",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0d13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Kurein M N",
    "copyright": "© 2026 Kurein M N · MIT",
    "homepage": "https://github.com/maximkurein/DigiPot-Studio",
    "license": "MIT",
    "shortDescription": "8-битный цифровой потенциометр с EEPROM и SPI",
    "longDescription": "Управление, моделирование и изучение Microchip MCP4161 и оценочной платы DIGI POT click (MIKROE-923).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
